{
	"name": "@wsrt/plugin-vite",
	"version": "0.1.0",
	"type": "module",
	"private": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"import": "./dist/vite.js"
		},
		"./adapter": {
			"types": "./dist/adapter.d.ts",
			"import": "./dist/adapter.js"
		},
		"./aliases": {
			"types": "./dist/aliases.d.ts",
			"import": "./dist/aliases.js"
		},
		"./bridge": {
			"types": "./dist/bridge.d.ts",
			"import": "./dist/bridge.js"
		},
		"./config": {
			"types": "./dist/config.d.ts",
			"import": "./dist/config.js"
		},
		"./plugin": {
			"types": "./dist/plugin.d.ts",
			"import": "./dist/plugin.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"import": "./dist/types.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@wsrt/capabilities": "workspace:*",
		"@wsrt/plugins": "workspace:*",
		"@wsrt/runtime-node": "workspace:*",
		"@wsrt/workspace": "workspace:*",
		"vite": "^8.0.8"
	},
	"devDependencies": {
		"@types/node": "^24.12.2",
		"typescript": "^5.9.3"
	}
}
