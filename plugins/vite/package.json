		"vite": "^8.0.8"
	},
	"devDependencies": {
		"@types/node": "^24.12.2",
		"typescript": "^5.9.3"
	},
	"description": "Vite execution, workspace aliases, and telemetry integration for WSRT.",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/forafekt/wsrt.git",
		"directory": "plugins/vite"
	},
	"bugs": {
		"url": "https://github.com/forafekt/wsrt/issues"
	},
	"homepage": "https://github.com/forafekt/wsrt#readme",
	"keywords": [
