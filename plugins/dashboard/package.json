{
	"name": "@wsrt/plugin-dashboard",
	"version": "0.1.0-alpha.0",
	"type": "module",
	"private": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test:browser": "node --test tests/browser.test.mjs",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@wsrt/control-plane": "workspace:*",
		"@wsrt/plugins": "workspace:*",
		"@wsrt/workspace-session": "workspace:*"
	},
	"description": "A local browser dashboard plugin for the WSRT control plane.",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/forafekt/wsrt.git",
		"directory": "plugins/dashboard"
	},
	"bugs": {
		"url": "https://github.com/forafekt/wsrt/issues"
	},
	"homepage": "https://github.com/forafekt/wsrt#readme",
	"keywords": [
		"wsrt",
		"workspace",
		"orchestration"
	],
	"engines": {
		"node": ">=22.0.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"sideEffects": false,
	"devDependencies": {
		"playwright": "^1.61.1"
	}
}
