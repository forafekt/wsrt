{
	"name": "@wsrt/decouple",
	"version": "0.1.0-alpha.0",
	"type": "module",
	"private": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"description": "Decouple is a library that provides a set of utilities for decoupling dependencies in TypeScript applications. It allows developers to define and manage dependencies in a more flexible and modular way, promoting better code organization and maintainability.",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/forafekt/wsrt.git",
		"directory": "libraries/decouple"
	},
	"bugs": {
		"url": "https://github.com/forafekt/wsrt/issues"
	},
	"homepage": "https://github.com/forafekt/wsrt#readme",
	"keywords": [
		"wsrt",
		"workspace",
		"orchestration",
		"dependency",
		"management",
		"decoupling",
		"dependency injection"
	],
	"engines": {
		"node": ">=22.0.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"sideEffects": false
}
