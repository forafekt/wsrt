{
  "name": "wsrt-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "WSRT is a runtime-first workspace orchestration monorepo.",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm run build && node --test tests/*.mjs",
    "wsrt": "pnpm exec node ./packages/cli/dist/index.js",
    "clean:prune": "rimraf --glob **/node_modules **/pnpm-lock.yaml **/dist",
    "clean:install": "pnpm clean:prune && pnpm install",
    "clean:vue-dts": "find packages -type f -path \"*/src/*.vue.d.ts\" -delete",
    "clean:dts": "find packages -type f -path \"*/src/*.d.ts\" -delete",
    "clean:js": "find packages -type f -path \"*/src/*.js\" -delete",
    "clean:node_modules": "find packages -type f -path \"*/node_modules\" -delete"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "esbuild": "^0.28.1",
    "vite": "^8.0.8",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@wsrt/core": "workspace:*",
    "@wsrt/plugin-dashboard": "workspace:*",
    "@wsrt/plugin-git": "workspace:*",
    "@wsrt/plugin-typescript": "workspace:*",
    "@wsrt/plugin-utils": "workspace:*",
    "@wsrt/plugin-vite": "workspace:*",
    "@wsrt/plugin-workspace": "workspace:*",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "keywords": [],
  "license": "ISC",
  "packageManager": "pnpm@10.12.4"
}
