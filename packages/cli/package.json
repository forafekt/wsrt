{
	"name": "@wsrt/cli",
	"version": "0.1.0-alpha.0",
	"type": "module",
	"private": false,
	"main": "./dist/cli.js",
	"module": "./dist/cli.js",
	"types": "./dist/cli.d.ts",
	"bin": {
		"wsrt": "./dist/index.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/cli.d.ts",
			"import": "./dist/cli.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@wsrt/commandline": "workspace:*",
		"@wsrt/config": "workspace:*",
		"@wsrt/console": "workspace:*",
		"@wsrt/control-plane": "workspace:*",
		"@wsrt/plugins": "workspace:*",
		"@wsrt/workspace": "workspace:*"
	},
	"description": "The WSRT command-line interface for inspecting and operating local software systems.",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/forafekt/wsrt.git",
		"directory": "packages/cli"
	},
	"bugs": {
		"url": "https://github.com/forafekt/wsrt/issues"
	},
	"homepage": "https://github.com/forafekt/wsrt#readme",
	"keywords": [
		"wsrt",
		"workspace",
		"orchestration"
	],
	"engines": {
		"node": ">=22.0.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"sideEffects": false
}
