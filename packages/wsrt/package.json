{
	"name": "wsrt",
	"version": "0.1.0-alpha.0",
	"type": "module",
	"private": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"wsrt": "./dist/cli.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@wsrt/cli": "workspace:*",
		"@wsrt/config": "workspace:*",
		"@wsrt/control-plane": "workspace:*",
		"@wsrt/runtime-node": "workspace:*"
	},
	"description": "The batteries-included WSRT distribution for Node.js.",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/forafekt/wsrt.git",
		"directory": "packages/wsrt"
	},
	"bugs": {
		"url": "https://github.com/forafekt/wsrt/issues"
	},
	"homepage": "https://github.com/forafekt/wsrt#readme",
	"keywords": [
		"wsrt",
		"workspace",
		"orchestration",
		"cli"
	],
	"engines": {
		"node": ">=22.0.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"sideEffects": false
}
