{
	"name": "@wsrt/config",
	"version": "0.1.0-alpha.0",
	"type": "module",
	"private": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"schema",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./schema": {
			"default": "./schema/wsrt.schema.json"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"schema:generate": "node ../../scripts/generate-config-schema.mjs",
		"schema:check": "node ../../scripts/generate-config-schema.mjs --check",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@wsrt/graph": "workspace:*",
		"esbuild": "^0.28.1",
		"yaml": "^2.9.0"
	},
	"description": "Configuration loading, normalization, and system definition helpers for WSRT.",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/forafekt/wsrt.git",
		"directory": "packages/config"
	},
	"bugs": {
		"url": "https://github.com/forafekt/wsrt/issues"
	},
	"homepage": "https://github.com/forafekt/wsrt#readme",
	"keywords": [
		"wsrt",
		"workspace",
		"orchestration"
	],
	"engines": {
		"node": ">=22.0.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"sideEffects": false
}
